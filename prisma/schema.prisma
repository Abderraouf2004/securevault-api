model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  password String? // يمكن يكون فارغ لحساب Google
  googleId String? @unique
  avatar   String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document Document[]
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]
}

model Document {
  id          String   @id @default(uuid())
  title       String
  ownerId     String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])
}
