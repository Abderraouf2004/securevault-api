// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  password String?
  googleId String? @unique
  avatar   String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document Document[]
  secrets  Secret[]

  @@index([roleId])
  @@index([createdAt])
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  users User[]
}

model Document {
  id            String                @id @default(uuid())
  title         String
  ownerId       String
  description   String?
  originalName  String
  storageKey    String                @unique
  mimeType      String
  size          Int
  storageStatus DocumentStorageStatus @default(PENDING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([storageStatus, createdAt])
}

model Secret {
  id        String   @id @default(uuid())
  name      String
  Value     String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId, createdAt(sort: Desc)])
}

enum DocumentStorageStatus {
  PENDING
  READY
  DELETING
}
